MODULE_NAME = spk_3dbcpmig

MODDIR    = $(SRCDIR)/cs/modules/$(MODULE_NAME)
MODULE    = $(MODDIR)/mod_$(MODULE_NAME).cc
OBJS      = $(OBJDIR)/mod_$(MODULE_NAME).o
F77DIR    = $(MODDIR)/fortran
# rotinas comuns (fftl2d, dwnn, fftc, vshift1, sgivshift1, sgimrg2r, bndry...) do SPK_DVSMIG3D
F77LIB    = $(SRCDIR)/cs/modules/spk_dvsmig3d/fortran
OBJS_F77  = $(OBJDIR)/spkbcp3d.o $(OBJDIR)/spkbcp3d_sub.o $(OBJDIR)/spkbcp3d_dvslib.o $(OBJDIR)/spkbcp3d_dvssub.o $(OBJDIR)/spkbcp3d_cfft.o
LIB_v1.0  = libmod_$(MODULE_NAME).so.1.0

# -std=legacy: codigo Fortran 77 antigo (mesmo vetor passado como real e complexo)
# -fno-automatic em bcp3d_sub.f: variaveis locais estaticas, como no g77
F77_LEGACY = $(F77_FLAGS) -std=legacy -fPIC

INCS =  -I"$(SRCDIR)/cs/geolib"  -I"$(SRCDIR)/cs/system" -I"$(MODDIR)"

ALL_FLAGS = $(INCS) $(COMMON_FLAGS) -fPIC

default: $(OBJS_F77) $(OBJS) $(LIBDIR)/$(LIB_v1.0)

clean:
	rm -f $(OBJS) $(OBJS_F77)

bleach: clean
	rm -f $(LIBDIR)/$(LIB_v1.0)

$(OBJDIR)/mod_$(MODULE_NAME).o: $(MODULE)
	$(CPP) -c $(ALL_FLAGS) $(MODULE) -o $(OBJDIR)/mod_$(MODULE_NAME).o

$(LIBDIR)/$(LIB_v1.0): $(OBJS) $(OBJS_F77)
	$(CPP) -fPIC -shared -Wl,-$(SONAME),$(LIB_v1.0) -Wl,-rpath,$(LIBDIR) -o $(LIBDIR)/$(LIB_v1.0) $(OBJS) $(OBJS_F77) -L$(LIBDIR) -lc -lgeolib -lcseis_system -lgfortran

$(OBJDIR)/spkbcp3d.o: $(F77DIR)/spkbcp3d.f
	$(F77) -c $(F77_LEGACY) $(F77DIR)/spkbcp3d.f -o $(OBJDIR)/spkbcp3d.o

$(OBJDIR)/spkbcp3d_sub.o: $(F77DIR)/bcp3d_sub.f
	$(F77) -c $(F77_LEGACY) -fno-automatic $(F77DIR)/bcp3d_sub.f -o $(OBJDIR)/spkbcp3d_sub.o

$(OBJDIR)/spkbcp3d_dvslib.o: $(F77LIB)/dvslib_mig3d.f
	$(F77) -c $(F77_LEGACY) $(F77LIB)/dvslib_mig3d.f -o $(OBJDIR)/spkbcp3d_dvslib.o

$(OBJDIR)/spkbcp3d_dvssub.o: $(F77LIB)/dvsmig3d_sub.f
	$(F77) -c $(F77_LEGACY) $(F77LIB)/dvsmig3d_sub.f -o $(OBJDIR)/spkbcp3d_dvssub.o

$(OBJDIR)/spkbcp3d_cfft.o: $(F77LIB)/cfftpack.f
	$(F77) -c $(F77_LEGACY) $(F77LIB)/cfftpack.f -o $(OBJDIR)/spkbcp3d_cfft.o
